{
  // VS Code propose d'installer ces extensions à l'ouverture du projet.
  "recommendations": [
    "github.vscode-pull-request-github",   // pull requests et revues dans VS Code
    "ms-azuretools.vscode-docker",         // docker-compose, conteneurs, logs
