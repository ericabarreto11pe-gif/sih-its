    "redhat.vscode-xml",                   // CDA : coloration et validation XML
    "redhat.vscode-yaml",                  // docker-compose.yml
    "ms-python.python",                    // scripts de la modalité simulée
    "bierner.markdown-mermaid",            // diagrammes Mermaid dans les .md
    "editorconfig.editorconfig"
  ]
}
