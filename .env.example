# Copier ce fichier en .env (cp .env.example .env) puis changer les mots de passe.
# Le fichier .env n'est jamais commité (voir .gitignore).

# Base PostgreSQL du serveur FHIR
POSTGRES_USER=hapi
POSTGRES_PASSWORD=changeme

# Compte utilisé par le RIS et le SIH pour l'API REST d'Orthanc
ORTHANC_UTILISATEUR=ris
ORTHANC_MOT_DE_PASSE=changeme

# Racine OID du projet (identifiants CDA et UID DICOM) – voir docs/conception/01-identifiants.md
SIH_OID_RACINE=2.25.15160578678088058174301844912568396362
